{
  "name": "uyap-udf",
  "version": "0.1.0",
  "description": "PDF to UDF converter for UYAP: turns PDF documents into UYAP UDF files by embedding rasterized page images. Node.js and TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halitsever/uyap-pdf.git"
  },
  "homepage": "https://projects.halit.org/uyap-pdf/",
  "bugs": "https://github.com/halitsever/uyap-pdf/issues",
  "author": "Halit Sever",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "udf",
    "uyap",
    "pdf",
    "converter",
    "pdf-to-udf",
    "udf-converter",
    "uyap-udf",
    "uyap-dokuman",
    "pdf-converter",
    "legal-tech",
    "turkey",
    "pdfium",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@hyzyla/pdfium": "^3.0.0",
    "pizzip": "^3.3.0",
    "sharp": "^0.35.5",
    "udf-cli": "^0.5.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
